# Forexscalpper Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# SECURITY KEYS (REQUIRED)
# ============================================
# Generate these securely using: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=your_256_bit_hex_key_here
SALT=your_secure_salt_here

# ============================================
# ADMINISTRATOR CREDENTIALS (REQUIRED)
# ============================================
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_password_here
ADMIN_PIN=your_secure_pin_here

# ============================================
# MT5 BROKER CREDENTIALS (REQUIRED)
# ============================================
MT5_SERVER=your_mt5_server
MT5_ACCOUNT_ID=your_account_id
MT5_PASSWORD=your_mt5_password
MT5_LEVERAGE=1:100
MT5_ENVIRONMENT=Demo

# ============================================
# SESSION MANAGEMENT (REQUIRED)
# ============================================
SESSION_SECRET=your_session_secret_key_here

# ============================================
# OPTIONAL: Third-Party Services
# ============================================
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id
